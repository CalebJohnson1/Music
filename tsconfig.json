{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["es2015", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "outDir": "./dist",
    "module": "none",
    "types": [],
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
